# Searchtide : ces trois lignes suffisent. Stripe, Google, e-mail, ntfy, Postgres, PageSpeed…
# se branchent ensuite dans l'application, écran « Connexions » : aucun autre fichier à modifier, aucun redémarrage.

# Chiffre vos clés dans l'instance : 32 caractères aléatoires ou plus (par exemple : openssl rand -hex 32).
# Facultatif en Docker : généré et enregistré dans le volume au premier lancement. Ne le changez pas après coup
# et sauvegardez-le : si cette valeur change, il faudra reconnecter vos services.
SECRET=
# Mot de passe de connexion de l'administrateur. Facultatif en Docker : généré au premier lancement et affiché
# dans les journaux (docker compose logs searchtide).
ADMIN_PASSWORD=
# Facultatif : adresse publique de l'instance (liens du rapport hebdomadaire, désinscriptions et
# retour OAuth des réseaux). Renseignez-la si vous connectez LinkedIn : le retour attendu par
# LinkedIn est PUBLIC_URL/api/pub-oauth/linkedin/callback (par exemple
# https://stats.nadirdaoudi.com/api/pub-oauth/linkedin/callback).
PUBLIC_URL=

# ── Avancé (les valeurs par défaut conviennent) ──
# PORT=3030
# HOST=127.0.0.1
# DATABASE_PATH=data/searchtide.db
# BACKUP_DIR=
# PLUGINS_DIR=          # dossier de modules privés (un fichier .ts par module), voir docs/guides/modules-prives.md
# TOTP_SECRET=         # double authentification : lancez `npm run 2fa`, qui remplit cette ligne
# DEMO=1               # démonstration publique : lecture ouverte, écriture protégée, ni CRM ni connexions
# API_KEY=             # clé d'API pour scripts ; pour un agent IA, créez plutôt sa clé dans l'application (Agents IA)
# RELAY_URL=            # facultatif : relais Searchtide Connect (https://connect.nadirdaoudi.com) ; vide = bouton OAuth masqué

# Publication LinkedIn (facultatif) : application « Share on LinkedIn » de LinkedIn Developers.
# Sans ces deux valeurs, le bouton « Connecter LinkedIn » de l'écran Connexions affiche la marche à suivre.
# Le retour OAuth à déclarer chez LinkedIn est PUBLIC_URL/api/pub-oauth/linkedin/callback.
# Le jeton d'accès dure 60 jours ; Searchtide ne demande pas de jeton de rafraîchissement.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Fuseau des journées (défaut Europe/Paris) ; tout fuseau IANA accepté.
# DAY_TZ=Europe/Paris

# Derrière un proxy de confiance uniquement : "cloudflare" lit cf-connecting-ip ; un entier N lit le
# N-ième X-Forwarded-For en partant de la droite. Sans cette variable, l'adresse TCP est utilisée.
# TRUST_PROXY=cloudflare
