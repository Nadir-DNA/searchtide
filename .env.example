# Obligatoire : mot de passe du tableau de bord
ADMIN_PASSWORD=
# Obligatoire : chaîne aléatoire longue (openssl rand -hex 32)
SECRET=

# Optionnel : clé pour les agents et l'API ("Authorization: Bearer ...")
API_KEY=

# Optionnel : Google Search Console, chemin du fichier JSON du compte de service (ou son contenu)
GOOGLE_SERVICE_ACCOUNT_JSON=

PORT=3030
DATABASE_PATH=data/searchtide.db
# Clé en lecture seule pour les agents (statistiques, outils MCP sans écriture)
API_KEY_READ=
# Double authentification : lancez `npm run 2fa`, qui remplit cette ligne
TOTP_SECRET=
# Dossier des sauvegardes quotidiennes (par défaut /data/backups dans Docker)
BACKUP_DIR=
