# Searchtide : ces trois lignes suffisent. Stripe, Google, e-mail, ntfy, Postgres, PageSpeed…
# se branchent ensuite dans l'application, écran « Connexions » : aucun autre fichier à modifier, aucun redémarrage.

# Chiffre vos clés dans l'instance : 32 caractères aléatoires ou plus (par exemple : openssl rand -hex 32).
# Ne le changez pas et sauvegardez-le : si cette valeur change, il faudra reconnecter vos services.
SECRET=
# Mot de passe de connexion de l'administrateur.
ADMIN_PASSWORD=
# Facultatif : adresse publique de l'instance (liens du rapport hebdomadaire et des désinscriptions).
PUBLIC_URL=

# ── Avancé (les valeurs par défaut conviennent) ──
# PORT=3030
# HOST=127.0.0.1
# DATABASE_PATH=data/searchtide.db
# BACKUP_DIR=
# TOTP_SECRET=         # double authentification : lancez `npm run 2fa`, qui remplit cette ligne
# DEMO=1               # démonstration publique : lecture ouverte, écriture protégée, ni CRM ni connexions
# API_KEY=             # clé d'API pour scripts ; pour un agent IA, créez plutôt sa clé dans l'application (Agents IA)
